FROM docker.io/library/node:26.11.1-bookworm-slim@sha256:86f07bc9c5dce4578cf37e5a418b7bfc7f817cda25cde66e2b66e95ed86c4567

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
COPY scripts/install-actionlint.mjs /tmp/install-actionlint.mjs
RUN node /tmp/install-actionlint.mjs /usr/local/bin \
    && rm /tmp/install-actionlint.mjs \
    && npm install --global pnpm@10.33.4 typescript-language-server@5.0.0 \
    && npx --yes playwright@1.64.1 install --with-deps chromium \
    && chmod -R a+rX /opt/playwright-browsers \
    && npm cache clean --force

USER 1000:1000
CMD ["sleep", "infinity"]
