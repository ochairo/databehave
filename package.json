{
  "name": "databehave-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Composable data behavior and HTTP plugins for Databehave.",
  "license": "MIT",
  "author": "ochairo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ochairo/databehave.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "lint": "biome check",
    "pack:check": "node scripts/packaged-consumer.mjs",
    "api:check": "node scripts/api-reports.mjs",
    "api:update": "node scripts/api-reports.mjs --update",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "workflow:check": "actionlint -shellcheck= .github/workflows/*.yml",
    "test:tooling": "node --test scripts/*.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify",
    "release:dry-run": "node scripts/release.mjs dry-run",
    "signatures:check": "node scripts/check-signatures.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cyclonedx/cdxgen": "12.9.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "github-slugger": "2.0.0",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
