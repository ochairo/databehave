{
  "name": "@databehave/core",
  "version": "0.2.0",
  "description": "Instance-local typed plugin composition and application lifecycle.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ochairo/databehave.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build:test",
    "test": "node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
