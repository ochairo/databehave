{
  "name": "@databehave/admin",
  "version": "0.2.0",
  "description": "Explicit fault injection and Web Components admin plugins for Databehave",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build:admin": "vite build --config vite.admin.config.ts && mv assets/ui-shell.html assets/ui.html",
    "build": "pnpm build:admin && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run --coverage",
    "test:no-coverage": "vitest run",
    "clean": "rm -rf dist assets coverage"
  },
  "dependencies": {
    "@databehave/core": "workspace:*",
    "@databehave/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "ochairo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ochairo/databehave.git",
    "directory": "packages/admin"
  }
}
